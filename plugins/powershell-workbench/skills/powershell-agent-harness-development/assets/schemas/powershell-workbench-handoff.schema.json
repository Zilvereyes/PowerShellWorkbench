{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilvereyes.github.io/PowerShellWorkbench/schemas/handoff-input-1.0.json",
  "title": "PowerShell Workbench portable handoff input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "createdAt",
    "source",
    "destination",
    "project",
    "objective",
    "verifiedFacts",
    "changedFiles",
    "testResults",
    "unresolvedDecisions",
    "authorityBoundaries",
    "safetyBoundaries",
    "requestedActions",
    "reloadCanary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/task"
    },
    "destination": {
      "$ref": "#/$defs/task"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "pluginVersion", "pluginSha256"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "pluginVersion": {
          "type": "string",
          "minLength": 1
        },
        "pluginSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "verifiedFacts": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        {
          "$ref": "#/$defs/fact"
        }
      ]
    },
    "changedFiles": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileEvidence"
          }
        },
        {
          "$ref": "#/$defs/fileEvidence"
        }
      ]
    },
    "testResults": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testResult"
          }
        },
        {
          "$ref": "#/$defs/testResult"
        }
      ]
    },
    "unresolvedDecisions": {
      "$ref": "#/$defs/stringArray"
    },
    "authorityBoundaries": {
      "$ref": "#/$defs/stringArray"
    },
    "safetyBoundaries": {
      "$ref": "#/$defs/stringArray"
    },
    "requestedActions": {
      "$ref": "#/$defs/stringArray"
    },
    "reloadCanary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "stringArray": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "title"],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/fileEvidence"
              }
            },
            {
              "$ref": "#/$defs/fileEvidence"
            }
          ]
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "runtime", "status", "evidenceSha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["Passed", "Failed", "Blocked", "NotRun"]
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
