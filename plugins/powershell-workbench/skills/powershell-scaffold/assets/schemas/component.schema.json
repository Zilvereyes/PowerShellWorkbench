{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerShell Workbench component record",
  "type": "object",
  "required": [
    "schemaVersion",
    "componentId",
    "version",
    "language",
    "kind",
    "purpose",
    "entryPoint",
    "sha256",
    "contract",
    "dependencies",
    "derivedFrom",
    "provenance",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "componentId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "language": {
      "enum": [
        "powershell",
        "xml",
        "batch",
        "cmd",
        "lua",
        "python",
        "javascript",
        "typescript",
        "csharp",
        "json",
        "yaml",
        "html",
        "css",
        "bash",
        "sql",
        "toc"
      ]
    },
    "kind": {
      "enum": [
        "fragment",
        "function",
        "script",
        "module",
        "assembly"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "entryPoint": {
      "type": "string",
      "pattern": "^code(\\.[a-z0-9]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "bindings",
        "effects",
        "unresolved",
        "reviewed"
      ],
      "properties": {
        "inputs": {
          "type": "array"
        },
        "outputs": {
          "type": "array"
        },
        "bindings": {
          "type": "array"
        },
        "effects": {
          "type": "array"
        },
        "unresolved": {
          "type": "array"
        },
        "reviewed": {
          "type": "boolean"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "derivedFrom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "provenance": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "componentId",
        "version",
        "sha256"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
